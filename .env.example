# ─── Project ───────────────────────────────────────────────
PROJECT_NAME=sector-market-research
ENVIRONMENT=development          # development | staging | production

# ─── Paths ─────────────────────────────────────────────────
DATA_ROOT=data
DUCKDB_PATH=data/warehouse.duckdb
LOG_LEVEL=INFO

# ─── Kaggle API (optional — for live download) ──────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_DATASET=apoorvaappz/global-super-store-dataset

# ─── Airflow ───────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_here
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ─── Pipeline ──────────────────────────────────────────────
PIPELINE_BATCH_SIZE=10000
ENABLE_DATA_QUALITY=true
ENABLE_DBT=true
ENABLE_ANALYTICS=true
