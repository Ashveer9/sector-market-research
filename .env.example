# Copy to .env and fill in. .env is git-ignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# SECTOR_RESEARCH_MODEL=claude-opus-4-8
# SECTOR_RESEARCH_EFFORT=high
# SECTOR_RESEARCH_MAX_TOKENS=8000
# SECTOR_RESEARCH_MAX_RETRIES=4
# SECTOR_RESEARCH_ENABLE_WEB_SEARCH=true
# SECTOR_RESEARCH_MAX_WEB_SEARCHES=6
# SECTOR_RESEARCH_QUALITY_THRESHOLD=0.8
# SECTOR_RESEARCH_MAX_REVISIONS=2
